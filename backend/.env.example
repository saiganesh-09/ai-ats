# Copy to .env and fill in. .env is gitignored — never commit secrets.
DATABASE_URL=postgresql+psycopg://ats_user:ats_dev_password@localhost:5432/ai_ats
JWT_SECRET=generate-a-long-random-string-here
# Optional — without this, AI features run in mock mode (free, offline)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173
