DATABASE_URL=postgresql://user:password@localhost:5432/ai_ats
JWT_SECRET=generate-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Optional — AI runs in mock mode without this
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STORAGE_DIR=storage
CORS_ORIGIN=http://localhost:3000
PORT=3001

# Email — unset SMTP_HOST to use the console provider (dev default)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AI ATS <no-reply@ats.app>"

# Object storage — uncomment when swapping LocalStorageService for S3
# STORAGE_ENDPOINT=s3.amazonaws.com
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=ai-ats-resumes
