// AI ATS database schema — Prisma is the source of truth.
// `npx prisma migrate dev` diffs this file against the DB and generates SQL.
// Convention: camelCase in TypeScript, snake_case in Postgres (@map/@@map).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  RECRUITER
  HIRING_MANAGER
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  fullName      String   @map("full_name")
  passwordHash  String   @map("password_hash")
  role          Role     @default(CANDIDATE)
  isActive      Boolean  @default(true) @map("is_active")
  isSuperadmin  Boolean  @default(false) @map("is_superadmin")
  companyId     Int?     @map("company_id")
  company       Company? @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")

  profile               Profile?
  skills                CandidateSkill[]
  experiences           Experience[]
  educations            Education[]
  certifications        Certification[]
  resumes               Resume[]
  jobsPosted            Job[]              @relation("JobRecruiter")
  jobsManaged           Job[]              @relation("JobHiringManager")
  applications          Application[]      @relation("CandidateApplications")
  assignedApplications  Application[]      @relation("AssignedRecruiter")
  savedJobs             SavedJob[]
  notifications         Notification[]
  notes                 Note[]
  feedback              Feedback[]
  interviewsScheduled   Interview[]
  reports               Report[]
  refreshTokens         RefreshToken[]
  activityLogs          ActivityLog[]
  statusChanges         ApplicationStatusHistory[]

  @@map("users")
}

model Company {
  id         Int      @id @default(autoincrement())
  name       String
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at")

  users User[]
  jobs  Job[]

  @@map("companies")
}

// The Candidate subtype of User (class-table inheritance): exists only for
// role=CANDIDATE, holds candidate-only attributes. Recruiter/HM have no extra
// attributes, so they need no subtype table — their data is entirely on User.
model Profile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline  String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

// Normalized skills taxonomy: one canonical row per skill, linked M:N to
// candidates (CandidateSkill) and jobs (JobSkill). Enables "jobs matching
// your skills" and recruiter skill search — impossible with text[] columns.
model Skill {
  id   Int    @id @default(autoincrement())
  name String @unique // lowercase canonical form

  candidates CandidateSkill[]
  jobs       JobSkill[]

  @@map("skills")
}

model CandidateSkill {
  userId  Int    @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId Int    @map("skill_id")
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  source  String @default("manual") // 'manual' | 'resume' — provenance

  @@id([userId, skillId])
  @@map("candidate_skills")
}

model JobSkill {
  jobId    Int     @map("job_id")
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId  Int     @map("skill_id")
  skill    Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  required Boolean @default(true) // false = "preferred/nice-to-have"

  @@id([jobId, skillId])
  @@index([skillId]) // "jobs needing skill X" — PK order doesn't cover this
  @@map("job_skills")
}

// Structured candidate history — normalized rows, one parent each (User).
model Experience {
  id          Int     @id @default(autoincrement())
  userId      Int     @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  company     String
  years       Int?
  description String?

  @@index([userId])
  @@map("experiences")
}

model Education {
  id          Int    @id @default(autoincrement())
  userId      Int    @map("user_id")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  degree      String
  institution String
  year        Int?

  @@index([userId])
  @@map("educations")
}

model Certification {
  id     Int    @id @default(autoincrement())
  userId Int    @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  issuer String?
  year   Int?

  @@index([userId])
  @@map("certifications")
}

model Job {
  id              Int       @id @default(autoincrement())
  companyId       Int       @map("company_id")
  company         Company   @relation(fields: [companyId], references: [id])
  recruiterId     Int       @map("recruiter_id")
  recruiter       User      @relation("JobRecruiter", fields: [recruiterId], references: [id])
  hiringManagerId Int?      @map("hiring_manager_id")
  hiringManager   User?     @relation("JobHiringManager", fields: [hiringManagerId], references: [id])
  title                String
  location             String?
  description          String
  requirements         String?
  employmentType       EmploymentType  @default(FULL_TIME) @map("employment_type")
  experienceLevel      ExperienceLevel @default(MID) @map("experience_level")
  workMode             WorkMode        @default(ONSITE) @map("work_mode")
  salaryMin            Int?            @map("salary_min") // annual
  salaryMax            Int?            @map("salary_max")
  educationRequirement String?         @map("education_requirement")
  applicationDeadline  DateTime?       @map("application_deadline")
  openings             Int             @default(1)
  status               JobStatus       @default(DRAFT)
  createdAt            DateTime        @default(now()) @map("created_at")

  applications Application[]
  savedBy      SavedJob[]
  reports      Report[]
  skills       JobSkill[]

  @@index([companyId])
  @@index([hiringManagerId])
  @@index([status, createdAt]) // public board: PUBLISHED + newest
  @@index([status, employmentType, workMode]) // common filter combo
  @@index([location])
  @@index([salaryMax])
  @@map("jobs")
}

enum ParsedStatus {
  PENDING
  PARSED
  FAILED
}

model Resume {
  id               Int      @id @default(autoincrement())
  candidateId      Int      @map("candidate_id")
  candidate        User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  originalFilename String   @map("original_filename")
  storageKey       String   @map("storage_key") // object-storage key, not a path
  rawText          String   @map("raw_text")
  parsed           Json?
  parsedStatus     ParsedStatus @default(PENDING) @map("parsed_status")
  createdAt        DateTime @default(now()) @map("created_at")

  applications Application[]

  @@index([candidateId])
  @@map("resumes")
}

model Application {
  id                  Int               @id @default(autoincrement())
  jobId               Int               @map("job_id")
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId         Int               @map("candidate_id")
  candidate           User              @relation("CandidateApplications", fields: [candidateId], references: [id])
  resumeId            Int               @map("resume_id")
  resume              Resume            @relation(fields: [resumeId], references: [id])
  assignedRecruiterId Int?              @map("assigned_recruiter_id")
  assignedRecruiter   User?             @relation("AssignedRecruiter", fields: [assignedRecruiterId], references: [id])
  coverNote           String?           @map("cover_note")
  status              ApplicationStatus @default(APPLIED)
  matchScore          Float?            @map("match_score")
  matchDetails        Json?             @map("match_details")
  aiSummary           String?           @map("ai_summary")
  createdAt           DateTime          @default(now()) @map("created_at")

  notes      Note[]
  feedback   Feedback[]
  interviews Interview[]
  history    ApplicationStatusHistory[]

  @@unique([jobId, candidateId]) // "apply once" enforced at the DB level
  @@index([candidateId])
  @@index([jobId, status])
  @@map("applications")
}

// Every status transition is recorded — powers the pipeline timeline and
// answers "when was this candidate shortlisted" forever.
model ApplicationStatusHistory {
  id            Int               @id @default(autoincrement())
  applicationId Int               @map("application_id")
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus @map("to_status")
  changedById   Int?              @map("changed_by_id")
  changedBy     User?             @relation(fields: [changedById], references: [id])
  reason        String?           // e.g. rejection reason — spec's optional field
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([applicationId])
  @@map("application_status_history")
}

model Note {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      Int         @map("author_id")
  author        User        @relation(fields: [authorId], references: [id])
  text          String
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("notes")
}

model Feedback {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewId   Int?        @map("interview_id")
  interview     Interview?  @relation(fields: [interviewId], references: [id])
  authorId      Int         @map("author_id")
  author        User        @relation(fields: [authorId], references: [id])
  rating        Int? // 1-5
  text          String
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("feedback")
}

model Interview {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledById Int         @map("scheduled_by_id")
  scheduledBy   User        @relation(fields: [scheduledById], references: [id])
  scheduledAt   DateTime    @map("scheduled_at")
  location      String?
  link          String?
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  feedback Feedback[]

  @@index([applicationId])
  @@map("interviews")
}

model SavedJob {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     Int      @map("job_id")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. "application.status", "interview.scheduled"
  payload   Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model Report {
  id         Int          @id @default(autoincrement())
  reporterId Int          @map("reporter_id")
  reporter   User         @relation(fields: [reporterId], references: [id])
  jobId      Int          @map("job_id")
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@map("reports")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // e.g. "user.registered", "job.published"
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("activity_log")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash") // we store a hash, never the raw token
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
